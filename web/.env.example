# Copy this file to .env.local and fill in the keys you have. Leave the rest empty.
# Never commit .env.local. In Vercel, add the same names under Project Settings -> Environment Variables.
# A provider is used only when its key is set. With no keys, the assistant uses the built-in helper.

# Order to try the providers in. The first one that gives a grounded answer wins.
LLM_ORDER=nvidia,groq,gemini,openai,anthropic,openrouter,perplexity,custom1,custom2,custom3

GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# One NVIDIA key gives a chain of free chat models and the microphone's speech-to-text.
NVIDIA_API_KEY=
# Optional: a comma-separated list of NVIDIA chat models to try in order
NVIDIA_MODELS=
# Optional: a separate key, or another hosted speech model, for the microphone
NVIDIA_ASR_API_KEY=
NVIDIA_ASR_FUNCTION_ID=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=

# Any other OpenAI-compatible service (a router or gateway). All three values are needed.
CUSTOM1_NAME=
CUSTOM1_API_KEY=
CUSTOM1_BASE_URL=
CUSTOM1_MODEL=

CUSTOM2_NAME=
CUSTOM2_API_KEY=
CUSTOM2_BASE_URL=
CUSTOM2_MODEL=

CUSTOM3_NAME=
CUSTOM3_API_KEY=
CUSTOM3_BASE_URL=
CUSTOM3_MODEL=
