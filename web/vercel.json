{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ask.js": {
      "includeFiles": "public/data/*.json",
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "includeFiles": "server/riva/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
